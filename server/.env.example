# Copy this file to .env and change the values if needed. .env is not uploaded to GitHub.

# Port of the Express server
PORT=3000

# TheMealDB key. "1" is the free test key from https://www.themealdb.com/api.php
MEALDB_API_KEY=1

# Hugging Face model for the AI category suggestion (runs locally with Transformers.js)
AI_MODEL=Xenova/nli-deberta-v3-xsmall
